# OpenWeatherMap API key — get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MongoDB Atlas connection string.
# When set, MongoDB is REQUIRED — the app retries and exits if it cannot connect.
# When unset, favorites are stored in a local JSON file (local-dev mode).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nimbus
# MONGODB_URI=mongodb+srv://... (legacy alias for MONGO_URI)

# PORT=5000
# CORS_ORIGIN=https://your-nimbus-frontend.onrender.com
# MONGO_MAX_ATTEMPTS=5
# MONGO_RETRY_DELAY_MS=3000